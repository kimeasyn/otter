#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export OTTER_UID="$(id -u)" OTTER_GID="$(id -g)"
export OTTER_DEV_NO_AUTH="${OTTER_DEV_NO_AUTH:-1}"
docker compose -f compose.dev.yml build dev
./scripts/in-dev bash -c 'pnpm install --frozen-lockfile && pnpm build && cargo build -p otterd && mkdir -p artifacts/dev && cp /cache/target/debug/otterd artifacts/dev/otterd'
exec node scripts/launch.mjs
